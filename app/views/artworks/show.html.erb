<% content_for :title, "#{@artwork.title} — The Met Collection" %>
<% content_for :description, "#{@artwork.title} by #{@artwork.artist}. #{@artwork.medium}" %>
<div class="max-w-5xl mx-auto px-4 py-8">
  <%= link_to "← Back to collection", artworks_path,
      class: "text-sm text-gray-500 hover:text-black mb-8 inline-block font-body" %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mt-6">
    <div class="bg-gray-50 flex items-center justify-center p-4">
      <a href="<%= @artwork.image_url %>"
      data-controller="lightbox"
      data-lightbox-target="trigger"
      data-pswp-src="<%= @artwork.image_url %>"
      class="lightbox-trigger block w-full h-full">
        <img src="<%= @artwork.image_url %>"
            alt="<%= @artwork.title %>"
            class="max-h-[600px] object-contain" />
      </a>
    </div>

    <div>
      <h1 class="text-2xl font-light mb-1 font-body"><%= @artwork.title %></h1>
      <p class="text-gray-600 mb-6 font-body"><%= @artwork.artist %></p>

      <dl class="space-y-4 text-sm">
        <% {
          "Date"        => @artwork.date,
          "Medium"      => @artwork.medium,
          "Dimensions"  => @artwork.dimensions,
          "Department"  => @artwork.department,
          "Credit"      => @artwork.credit_line
        }.each do |label, value| %>
          <% if value.present? %>
            <div>
              <dt class="text-xs uppercase tracking-widest text-gray-400 mb-1 font-body"><%= label %></dt>
              <dd class="text-gray-800 font-body"><%= value %></dd>
            </div>
          <% end %>
        <% end %>
      </dl>

      <% if @artwork.on_view %>
        <p class="mt-8 inline-block bg-black text-white text-xs px-3 py-1 tracking-widest uppercase font-body">
          On View
        </p>
      <% end %>
    </div>
  </div>
</div>