<div class="max-w-7xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-light tracking-wide mb-8 font-heading">The Met Collection</h1>

  <%# Search form %>
  <form action="<%= artworks_path %>" method="get" class="mb-8 flex gap-3">
    <input
      type="text"
      name="q"
      value="<%= @query %>"
      placeholder="Search artworks..."
      class="flex-1 border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:border-gray-600 font-body"
    />
    <button type="submit"
      class="bg-black text-white px-6 py-2 text-sm tracking-widest uppercase hover:bg-gray-800 transition font-body">
      Search
    </button>
  </form>

  <%# Results grid %>
  <div  data-controller="load-more"  data-load-more-page-value="2" data-load-more-query-value="<%= @query %>" data-load-more-department-id="<%= @department_id %>">
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"  data-load-more-target="grid">
      <% @artworks.each do |artwork| %>
        <%= render "artworks/artwork_card", artwork: artwork %>
      <% end %>
    </div>
    <button data-action="click->load-more#loadMore" data-load-more-target="button"  class="col-span-full bg-gray-200 text-gray-700 px-4 py-2 text-sm hover:bg-gray-300 transition font-body mt-6 cursor-pointer">
      Load More
    </button>
  </div>
</div>