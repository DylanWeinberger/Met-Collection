<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "The Met Collection" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Browse the Metropolitan Museum of Art's open collection" %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col bg-white text-gray-900 antialiased">

    <%= render "layouts/header" %>

    <main class="flex-1" id="main-content">
      <% if notice.present? %>
        <div class="bg-green-50 border-b border-green-200 px-6 py-3 text-sm text-green-800">
          <%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="bg-red-50 border-b border-red-200 px-6 py-3 text-sm text-red-800">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <%= render "layouts/footer" %>
  <div id="page-loader" class="fixed inset-0 bg-white z-[9999] flex items-center justify-center transition-all duration-700">
    <div class="flex flex-col items-center gap-4">
      <div class="w-20 h-20 bg-black flex items-center justify-center">
        <span class="text-white text-4xl font-bold font-heading tracking-widest">M</span>
      </div>
    </div>
  </div>
  </body>
</html>